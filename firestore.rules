rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Admin Security Configuration
    match /admin_config/{document} {
      allow read, write: if request.auth != null && request.auth.token.email == "omarfarukitbd@gmail.com";
    }

    // 2. Class Data (Public Read, Secure Write)
    match /classes/{classId} {
      // Mobile app users can always read the data
      allow read: if true;
      
      // Only the authenticated admin with the correct Master PIN can write
      allow write: if request.auth != null 
                   && request.auth.token.email == "omarfarukitbd@gmail.com"
                   && get(/databases/$(database)/documents/admin_config/current_session).data.pin == get(/databases/$(database)/documents/admin_config/security).data.master_pin
                   && get(/databases/$(database)/documents/admin_config/current_session).data.valid_until > request.time.toMillis();
    }

    // 3. In-App Notifications Collection (Public Read, Secure Admin Write)
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "omarfarukitbd@gmail.com";
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

